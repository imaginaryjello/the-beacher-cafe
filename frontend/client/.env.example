# Copy to .env and fill in. On Vercel these are set in the dashboard.
#
# WARNING: every VITE_* variable is compiled into the public JavaScript
# bundle and is readable by anyone. Never put secrets here.
#
# Base URL of the backend API — no trailing slash.
# Local:      http://localhost:5000
# Production: https://your-service.onrender.com
#
# This is baked in at BUILD time, so changing it on Vercel requires a
# redeploy, not just saving the variable.
VITE_API_URL=http://localhost:5000
