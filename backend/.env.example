# Copy to .env and fill in real values. Never commit .env itself.
# On Render these are set in the dashboard, not in a file.

# ── DATABASE ──
# MongoDB Atlas connection string.
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/beacher-cafe

# ── AUTH ──
# Signs and verifies JWTs. Generate a fresh one for production:
#   openssl rand -base64 48
# Changing this logs everyone out immediately.
JWT_SECRET=replace-with-a-long-random-string

# ── CLOUDINARY (image uploads) ──
# From your Cloudinary dashboard. cloud_name must match exactly.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret

# ── EMAIL (Resend) ──
# Reservation confirmations and password resets.
# NOTE: the default sender in config/email.js is onboarding@resend.dev, which
# only delivers to your own Resend account address. Verify a domain and change
# FROM before launch or customers receive nothing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── URLS ──
# Exact public origin of the frontend — no trailing slash.
# Used for CORS and for building password-reset links in emails.
FRONTEND_URL=http://localhost:5173

# Render injects PORT automatically in production; only needed locally.
PORT=5000

# ── ONE-OFF: creating the first owner account ──
# Only needed when running `npm run create-admin`. Remove afterwards.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=a-long-password
# ADMIN_NAME=Owner Name
# ADMIN_PHONE=416-555-0100
